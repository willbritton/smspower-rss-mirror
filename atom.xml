    <title mode="escaped">Development :: New programming language MasterBASIC</title>
    <link rel="alternate" type="text/html"
     href="https://www.smspower.org:443/forums/viewtopic.php?p=141348#141348"/>
    <dc:creator>Materion</dc:creator>
    <dc:subject>Development</dc:subject>
